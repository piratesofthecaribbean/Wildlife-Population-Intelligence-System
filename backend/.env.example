# =========================================================
# Wildlife Population Intelligence System - Backend Config
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to Git.
# =========================================================

# ---------------- App ----------------
APP_NAME="Wildlife Population Intelligence System"
APP_ENV=development          # development | production
DEBUG=True
API_V1_PREFIX=/api/v1

# ---------------- Database ----------------
# Local (docker-compose) example:
DATABASE_URL=postgresql://wildlife_user:wildlife_pass@localhost:5432/wildlife_db

# Render Postgres example (used in production):
# DATABASE_URL=postgresql://user:password@dpg-xxxxxxxx-a.oregon-postgres.render.com/wildlife_db

# ---------------- JWT Auth ----------------
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------- CORS ----------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://wildlife-population-intelligence-sy.vercel.app,https://wildlife-population-intelligence-system-byp4.vercel.app


# ---------------- File Storage ----------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# ---------------- AI Model ----------------
YOLO_MODEL_PATH=model/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.4
DEVICE=cpu                   # cpu | cuda

# ---------------- Alert Delivery ----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=alerts@wildlife.local
ALERT_EMAIL_RECIPIENTS=admin@example.com,warden@example.com

# ---------------- OAuth2 ----------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth2/google/callback

# ---------------- Deployment (Render) ----------------
PORT=8000
