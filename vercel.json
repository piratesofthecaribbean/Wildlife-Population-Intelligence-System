{
  "services": {
    "wpis-backend": {
      "root": "backend",
      "entrypoint": "app.main:app",
      "buildCommand": "pip install --upgrade pip && pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "wpis-backend"
      }
    }
  ]
}
